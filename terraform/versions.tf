terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project = "pg-demo-de-class"
      Owner   = var.owner
      Purpose = "temporary demo - destroy after the talk"
    }
  }
}
